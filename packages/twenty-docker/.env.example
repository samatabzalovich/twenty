# Local build (from packages/twenty-docker: docker compose up -d --build)
TWENTY_IMAGE=twenty
TAG=local

# Public URLs
SERVER_URL=https://crm.smart-biz.space
FRONTEND_URL=https://crm.smart-biz.space
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=app
FRONT_AUTO_BASE_URL=true
# false = allow SaaS auth to auto-create workspaces per business
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false

# Database
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
PG_DATABASE_NAME=default

# Secrets — use: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_a_random_string
# FALLBACK_ENCRYPTION_KEY= # set to the previous ENCRYPTION_KEY during a rotation
# APP_SECRET= # legacy: only required for instances that pre-date ENCRYPTION_KEY

# Storage (MinIO on smartbiz network)
STORAGE_TYPE=S3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_NAME=twenty
STORAGE_S3_ENDPOINT=http://smartbiz-minio:9000
STORAGE_S3_ACCESS_KEY_ID=replace_me
STORAGE_S3_SECRET_ACCESS_KEY=replace_me
STORAGE_S3_PRESIGNED_URL_BASE=https://s3.smart-biz.space

# SaaS auth (internal Docker URLs)
SAAS_AUTH_ENABLED=true
SAAS_AUTH_VALIDATE_URL=http://smartbiz-backend:8080/api/v1/auth/crm/validate
SAAS_AUTH_API_KEY_CALLBACK_URL=http://smartbiz-backend:8080/api/v1/auth/crm/api-key
SAAS_AUTH_CHECK_RECEIVED_SECRET=replace_me_with_saas_auth_shared_secret

# Optional
# DISABLE_DB_MIGRATIONS=
# DISABLE_CRON_JOBS_REGISTRATION=
